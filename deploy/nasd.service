[Unit]
Description=NAS management daemon (web UI)
After=network-online.target
Wants=network-online.target

[Service]
# The front display tells what's happening while nasd itself isn't running.
ExecStartPre=-/usr/local/bin/nasd -lcd-message "Starting...|please wait"
ExecStart=/usr/local/bin/nasd -listen :8443 -data /var/lib/nasd
Restart=on-failure
RestartSec=2
# Runs every time nasd stops, crash included: a fan nasd was slowing down
# must never stay slow without its controller.
ExecStopPost=/usr/local/bin/nasd -fans-full
ExecStopPost=-/usr/local/bin/nasd -lcd-message "NAS service|stopped"
# Runs as root (needs mdadm, smartctl, samba).
# No PrivateTmp/ProtectHome/ProtectSystem here: those give nasd its own mount
# namespace, so volumes it mounts would be invisible to the rest of the
# system (Samba included). Lesson learned in milestone 3.
NoNewPrivileges=yes
StateDirectory=nasd
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
